# ============================================================================
# ATLAS Gym Frontend - Variables de Entorno (.env.example)
# Copiar a .env.local en desarrollo o inyectar en build de producción.
# ============================================================================

# Ruta base consumida por el navegador.
# Por defecto "/backend-api" enruta por el mismo origen de Next.js hacia BACKEND_INTERNAL_URL
# (funciona desde celulares en Wi-Fi LAN 192.168.x.x:3000, tablet del Tótem y dominios HTTPS).
# Si se define una URL externa (ej: https://api.atlasgym.com.ar), el cliente agrega "/api" automáticamente si falta.
NEXT_PUBLIC_API_URL=/backend-api

# Destino interno en tiempo de ejecución del proxy de Next.js hacia Spring Boot (no requiere rebuild al cambiar de servidor)
BACKEND_INTERNAL_URL=http://127.0.0.1:8080

# NOTA DE SEGURIDAD (Tótem):
# Nunca exponer el secreto del Tótem con prefijo NEXT_PUBLIC_*.
# La clave ATLAS_TOTEM_SECRET se vincula una única vez de forma local en la tablet física (/totem -> Vincular terminal).

# Datos de cobro por transferencia que ven los alumnos en "Mis cuotas" y en los recordatorios de WhatsApp.
# Se leen al hacer el build (requiere rebuild si cambian). Si NEXT_PUBLIC_PAGO_ALIAS queda vacío,
# la app no muestra ningún alias y deriva el pago a recepción.
NEXT_PUBLIC_PAGO_ALIAS=
NEXT_PUBLIC_PAGO_TITULAR=
